# The server's settings, read by deploy/unravel-server.service. Copy to /etc/unravel-rule.env.

UNRAVEL_NETWORK=bitcoin

# Only the reverse proxy talks to the server: deploy/Caddyfile, or deploy/nginx.conf for per-IP limits.
UNRAVEL_ADDR=127.0.0.1:8322

# The folder holding web/static and web/pkg (built by `just wasm`).
UNRAVEL_ROOT=/opt/unravel-rule

# The server key. Back it up: it is half of every hop address's shared key, and losing it
# leaves users with only the safety net. Made on the first start, and only with the line below
# uncommented; take it out again afterwards, so that a missing key stops the server instead of
# quietly becoming a new one.
UNRAVEL_KEY_FILE=/var/lib/unravel-rule/bitcoin.key
#UNRAVEL_CREATE_KEY=1

# Our own Electrum server (electrs or Fulcrum) next to our own Bitcoin Core. tcp:// for one on
# this machine, ssl:// for one elsewhere with a valid certificate. A comma-separated list is
# tried in order, moving on when one fails. Unset, it uses Blockstream's public server, then
# another public one.
UNRAVEL_ELECTRUM=tcp://127.0.0.1:50001

# The donation wallet's descriptor. Unset, the server uses this one, built into the code. Set
# your own to receive the donations yourself.
# Each browser that presses donate keeps the receive address it gets. The first 1,000 go out
# in turn, then again from the first, so a wallet with a gap limit of 1,000 sees every
# donation. How many have gone out is saved in bitcoin-donation-index beside the key. Each
# hop address that pays one of them is listed, with its descriptor, in bitcoin-donations.txt
# beside the key. If a donor never comes back to forward, that descriptor and the donation
# wallet's seed claim the funds through the safety net. Back up both files with the key.
#UNRAVEL_DONATION=tr([fc739413/86h/0h/0h]xpub6BqAzFncdz3bYRdw2biQxUQYFJ3sd4j1ndJZqGXXuG95vCNahFu7SpjzUkjx2yJREtpwE679s6ELj545Q71MLsr9EQkTWgszeXPUdj33Thf/<0;1>/*)#8dyae2dl
